# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# octavo local data (sqlite db + uploads)
/data

# Security scan reports stay local — never in the public repo
/docs/security/

# Agent scaffolding files (regenerated locally by tooling)
CLAUDE.md
AGENTS.md
.shot-profile

# Vendored at build time by scripts/vendor-assets.mjs
/public/excalidraw-assets/

# Planning and competitive material — kept locally, never published.
/docs/internal/
